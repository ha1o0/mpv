     mov->fc = s;
+    ff_mov_bounded_reset(&mov->bounded_interleave);
     mov->trak_index = -1;
     mov->primary_item_id = -1;
     mov->cur_item_id = -1;
@@ -11463,7 +11464,7 @@
     return 0;
 }
 
-static AVIndexEntry *mov_find_next_sample(AVFormatContext *s, AVStream **st)
+static AVIndexEntry *mov_find_next_sample_legacy(AVFormatContext *s, AVStream **st)
 {
     AVIndexEntry *sample = NULL;
     int64_t best_dts = INT64_MAX;
@@ -11493,6 +11494,67 @@
     return sample;
 }
 
+static int mov_bounded_get_sample(void *opaque, unsigned i, MOVBoundedSample *out)
+{
+    AVFormatContext *s = opaque;
+    AVStream *st = s->streams[i];
+    MOVStreamContext *sc = st->priv_data;
+    FFStream *sti = ffstream(st);
+    AVIndexEntry *entry;
+
+    if (sc->iamf)
+        return -1;
+    if (st->discard == AVDISCARD_ALL ||
+        (st->disposition & AV_DISPOSITION_ATTACHED_PIC) || !sc->pb ||
+        sc->current_sample >= sti->nb_index_entries)
+        return 0;
+    // External references and IAMF retain their existing stream ownership and
+    // packet expansion rules. Missing/invalid clocks also use legacy order.
+    if (sc->pb != s->pb || sc->time_scale <= 0)
+        return -1;
+    entry = &sti->index_entries[sc->current_sample];
+    if (entry->timestamp == AV_NOPTS_VALUE)
+        return -1;
+    *out = (MOVBoundedSample){
+        .dts = av_rescale(entry->timestamp, AV_TIME_BASE, sc->time_scale),
+        .pos = entry->pos,
+        .anchor = st->codecpar->codec_type == AVMEDIA_TYPE_AUDIO ||
+                  st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO,
+    };
+    return 1;
+}
+
+static AVIndexEntry *mov_find_next_sample(AVFormatContext *s, AVStream **st)
+{
+    MOVContext *mov = s->priv_data;
+    AVIndexEntry *sample = mov_find_next_sample_legacy(s, st);
+    int was_active = mov->bounded_interleave.valid;
+    int chosen;
+
+    // Keep fragmented/live inputs, explicit physical order, and discarded
+    // track cursor advancement exactly as before. Bounded scheduling changes
+    // only the delivery order of selected samples in a complete flat index.
+    if (!sample || !mov->interleave_strategy || !mov->interleaved_read ||
+        !(s->pb->seekable & AVIO_SEEKABLE_NORMAL) ||
+        s->nb_stream_groups ||
+        mov->frag_index.nb_items || mov->fragment.moof_offset || mov->next_root_atom ||
+        (*st)->discard == AVDISCARD_ALL)
+        return sample;
+
+    chosen = ff_mov_bounded_choose(&mov->bounded_interleave, s->nb_streams, s,
+                                  mov_bounded_get_sample,
+                                  mov->interleave_preload_duration,
+                                  mov->interleave_preload_max_bytes);
+    if (chosen < 0)
+        return sample;
+    if (!was_active && mov->bounded_interleave.valid)
+        av_log(s, AV_LOG_VERBOSE, "Bounded MP4 interleave activated: duration=%"PRId64
+               " us bytes=%"PRId64"\n", mov->interleave_preload_duration,
+               mov->interleave_preload_max_bytes);
+    *st = s->streams[chosen];
+    return &ffstream(*st)->index_entries[((MOVStreamContext *)(*st)->priv_data)->current_sample];
+}
+
 static int should_retry(AVIOContext *pb, int error_code) {
     if (error_code == AVERROR_EOF || avio_feof(pb))
         return 0;
@@ -11888,6 +11950,7 @@
         return ret;
     }
 
+    ff_mov_bounded_record(&mov->bounded_interleave, st->index, pkt->size);
     return 0;
 }
 
@@ -12053,6 +12116,8 @@
     int sample;
     int i;
 
+    ff_mov_bounded_reset(&mc->bounded_interleave);
+
     if (stream_index >= s->nb_streams)
         return AVERROR_INVALIDDATA;
 
@@ -12089,7 +12154,7 @@
         }
         while (1) {
             MOVStreamContext *sc;
-            AVIndexEntry *entry = mov_find_next_sample(s, &st);
+            AVIndexEntry *entry = mov_find_next_sample_legacy(s, &st);
             if (!entry)
                 return AVERROR_INVALIDDATA;
             sc = st->priv_data;
@@ -12153,6 +12218,16 @@
         {.i64 = 0}, 0, 1, FLAGS },
     { "max_stts_delta", "treat offsets above this value as invalid", OFFSET(max_stts_delta), AV_OPT_TYPE_INT, {.i64 = UINT_MAX-48000*10 }, 0, UINT_MAX, .flags = AV_OPT_FLAG_DECODING_PARAM },
     { "interleaved_read", "Interleave packets from multiple tracks at demuxer level", OFFSET(interleaved_read), AV_OPT_TYPE_BOOL, {.i64 = 1 }, 0, 1, .flags = AV_OPT_FLAG_DECODING_PARAM },
+    { "interleave_strategy", "Packet read ordering for flat MOV/MP4", OFFSET(interleave_strategy),
+        AV_OPT_TYPE_INT, {.i64 = 0}, 0, 1, FLAGS, .unit = "interleave_strategy" },
+    { "legacy", "Use the existing DTS/file-position heuristic", 0,
+        AV_OPT_TYPE_CONST, {.i64 = 0}, 0, 0, FLAGS, .unit = "interleave_strategy" },
+    { "bounded", "Use bounded physical runs for widely separated selected tracks", 0,
+        AV_OPT_TYPE_CONST, {.i64 = 1}, 0, 0, FLAGS, .unit = "interleave_strategy" },
+    { "interleave_preload_duration", "Maximum DTS preload window for bounded interleave", OFFSET(interleave_preload_duration),
+        AV_OPT_TYPE_DURATION, {.i64 = 5 * AV_TIME_BASE}, 0, 30 * AV_TIME_BASE, FLAGS },
+    { "interleave_preload_max_bytes", "Logical preload byte budget before catching up lagging tracks", OFFSET(interleave_preload_max_bytes),
+        AV_OPT_TYPE_INT64, {.i64 = 8 * 1024 * 1024}, 0, 64 * 1024 * 1024, FLAGS },
 
     { NULL },
 };
