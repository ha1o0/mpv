+ * FOR A PARTICULAR PURPOSE. See the GNU Lesser General Public License for
+ * more details.
+ */
+
+#ifndef AVFORMAT_MOV_BOUNDED_INTERLEAVE_H
+#define AVFORMAT_MOV_BOUNDED_INTERLEAVE_H
+
+#include <limits.h>
+#include <stdint.h>
+
+typedef struct MOVBoundedSample {
+    int64_t dts; /* microseconds, after edit-list/index timestamp adjustment */
+    int64_t pos;
+    int anchor; /* selected audio/video, excluding attached pictures */
+} MOVBoundedSample;
+
+typedef struct MOVBoundedInterleave {
+    int valid;
+    int disabled;
+    int capped;
+    int last_av_stream;
+    uint64_t active_mask;
+    uint64_t anchor_mask;
+    int64_t start;
+    int64_t end;
+    int64_t window_bytes;
+} MOVBoundedInterleave;
+
+/* Return 1 for a selected pending sample, 0 for no sample, -1 if unsupported. */
+typedef int (*MOVBoundedGetSample)(void *, unsigned, MOVBoundedSample *);
+
+static inline void ff_mov_bounded_reset(MOVBoundedInterleave *b)
+{
+    *b = (MOVBoundedInterleave){ .last_av_stream = -1 };
+}
+
+static inline int64_t ff_mov_bounded_add(int64_t a, int64_t positive)
+{
+    return a > INT64_MAX - positive ? INT64_MAX : a + positive;
+}
+
+/*
+ * Prefer physical order inside a FIXED time window. Sliding a window after
+ * every audio packet releases only one more video packet at its boundary,
+ * recreating the very HTTP seek ping-pong this policy is intended to avoid.
+ *
+ * Accumulate the byte budget across the entire window, including intervening
+ * subtitle or other packets. Packet-stream switches must not reset it. When exhausted,
+ * shorten the window to the last selected A/V stream's next DTS and drain the
+ * lagging tracks before opening another window. Mandatory catch-up packets
+ * and a single large packet are not discarded to satisfy a byte budget.
+ * No packet storage is allocated here.
+ *
+ * This follows VLC's MP4 DemuxMoov/DemuxTrack design of physical-position
+ * preference with bounded DTS preload; it is not a port of VLC or Hills code.
+ */
+static inline int ff_mov_bounded_choose(MOVBoundedInterleave *b,
+                                        unsigned count, void *opaque,
+                                        MOVBoundedGetSample get,
+                                        int64_t duration, int64_t bytes)
+{
+    int64_t minimum = INT64_MAX, anchor = INT64_MAX;
+    int64_t low_pos = INT64_MAX, high_pos = 0;
+    unsigned anchors = 0;
+    uint64_t active_mask = 0, anchor_mask = 0;
+    MOVBoundedSample sample;
+
+    if (b->disabled || duration <= 0 || bytes <= 0)
+        return -1;
+    for (unsigned i = 0; i < count; i++) {
+        int available = get(opaque, i, &sample);
+        if (available < 0 || (available && (sample.dts == INT64_MIN ||
+            sample.dts == INT64_MAX || sample.pos < 0))) {
+            ff_mov_bounded_reset(b);
+            return -1;
+        }
+        if (!available)
+            continue;
+        // Avoid a lossy hash for detecting track selection changes. Files
+        // with selected stream indices outside this exact mask stay legacy.
+        if (i >= 64) {
+            ff_mov_bounded_reset(b);
+            return -1;
+        }
+        active_mask |= UINT64_C(1) << i;
+        if (sample.dts < minimum)
+            minimum = sample.dts;
+        if (!sample.anchor)
+            continue;
+        anchor_mask |= UINT64_C(1) << i;
+        anchors++;
+        if (sample.dts < anchor)
+            anchor = sample.dts;
+        if (sample.pos < low_pos)
+            low_pos = sample.pos;
+        if (sample.pos > high_pos)
+            high_pos = sample.pos;
+    }
+    if (anchors < 2) {
+        ff_mov_bounded_reset(b);
+        return -1;
+    }
+    if (b->valid && active_mask != b->active_mask)
+        ff_mov_bounded_reset(b);
+    // Ordinary interleaved MP4s keep the exact legacy packet order. Activate
+    // only when pending selected audio/video occupy widely separated regions.
+    if (!b->valid && high_pos - low_pos < 1024 * 1024)
+        return -1;
+    if (!b->valid || anchor < b->start || minimum >= b->end) {
+        b->valid = 1;
+        b->active_mask = active_mask;
+        b->anchor_mask = anchor_mask;
+        b->capped = 0;
+        b->start = anchor;
+        b->end = ff_mov_bounded_add(anchor, duration);
+        b->last_av_stream = -1;
+        b->window_bytes = 0;
+    }
+    if (!b->capped && b->last_av_stream >= 0 && b->window_bytes >= bytes &&
+        get(opaque, b->last_av_stream, &sample) > 0) {
+        // Degenerate non-advancing timestamps cannot bound a physical run.
+        // Retain legacy scheduling until the next seek rather than read a
+        // complete track under the guise of a small time window.
+        if (sample.dts <= b->start) {
+            b->disabled = 1;
+            return -1;
+        }
+        if (sample.dts > anchor && sample.dts < b->end) {
+            b->end = sample.dts;
+            b->capped = 1;
+        }
+    }
+
+    int selected = -1;
+    int64_t position = INT64_MAX;
+    for (unsigned i = 0; i < count; i++) {
+        if (get(opaque, i, &sample) > 0 && sample.dts < b->end &&
+            (selected < 0 || sample.pos < position)) {
+            selected = i;
+            position = sample.pos;
+        }
+    }
+    if (selected < 0)
+        ff_mov_bounded_reset(b);
+    return selected;
+}
+
+static inline void ff_mov_bounded_record(MOVBoundedInterleave *b,
+                                        int stream, int64_t bytes)
+{
+    if (!b->valid || bytes <= 0)
+        return;
+    if (stream >= 0 && stream < 64 &&
+        (b->anchor_mask & (UINT64_C(1) << stream)))
+        b->last_av_stream = stream;
+    b->window_bytes = ff_mov_bounded_add(b->window_bytes, bytes);
+}
+
+#endif
