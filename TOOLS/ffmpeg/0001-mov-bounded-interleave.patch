diff --git a/libavformat/mov_bounded_interleave.h b/libavformat/mov_bounded_interleave.h
new file mode 100644
--- /dev/null
+++ b/libavformat/mov_bounded_interleave.h
@@ -0,0 +1,171 @@
+/*
+ * Bounded MOV/MP4 physical read runs.
+ * Copyright (c) 2026 Floe contributors
+ *
+ * This file is part of FFmpeg.
+ *
